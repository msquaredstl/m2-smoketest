# Copy to .env in the m2-smoketest directory. Never commit .env.
# Run from a Magento subdirectory; M2_SMOKE_ROOT is optional.
# M2_SMOKE_ROOT=/path/to/magento
M2_SMOKE_BASE_URL=https://stage.dtfstore.com/
# Production alternative: https://dtfdistributors.com/
M2_SMOKE_EXPECTED_MODE=production

# Add as many named pages as needed. IDs use A-Z, 0-9 and underscores.
# Types: homepage, category, product, search, cart, checkout, login, custom.
# Relative paths use BASE_URL; absolute URLs must have the same origin.
# Quote values containing spaces, #, or other dotenv syntax.
M2_SMOKE_PAGE_HOMEPAGE_URL=/
M2_SMOKE_PAGE_HOMEPAGE_TYPE=homepage
M2_SMOKE_PAGE_CATEGORY_URL=
M2_SMOKE_PAGE_CATEGORY_TYPE=category
M2_SMOKE_PAGE_PRODUCT_URL=
M2_SMOKE_PAGE_PRODUCT_TYPE=product
M2_SMOKE_PAGE_SEARCH_URL=
M2_SMOKE_PAGE_SEARCH_TYPE=search

# Example additional page (replace with a known-good URL):
# M2_SMOKE_PAGE_VINYL_URL=/your-vinyl-category.html
# M2_SMOKE_PAGE_VINYL_TYPE=category
# M2_SMOKE_PAGE_PRODUCT_TWO_URL=/your-second-product.html
# M2_SMOKE_PAGE_PRODUCT_TWO_TYPE=product

# Optional staging HTTP Basic authentication, never included in reports:
M2_SMOKE_HTTP_USER=
M2_SMOKE_HTTP_PASSWORD=

M2_SMOKE_COMMAND_TIMEOUT=30
M2_SMOKE_RUN_TIMEOUT=120
M2_SMOKE_HTTP_TIMEOUT=10
M2_SMOKE_MAX_ASSETS=60
M2_SMOKE_LOG_LOOKBACK_MINUTES=15
M2_SMOKE_CRON_STALE_MINUTES=10
# Optional YAML file for assertions/thresholds; relative to the .env directory:
# M2_SMOKE_CONFIG=config/staging.local.yml
